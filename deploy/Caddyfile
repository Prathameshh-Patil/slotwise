# One address for the whole app, like a real deployment:
#   /api/...  -> FastAPI (the /api prefix is stripped before forwarding)
#   anything else -> Next.js
#
# SITE_ADDRESS decides how it is served:
#   unset (local)          -> plain HTTP on :80 inside the container
#   a hostname (a server)  -> Caddy gets a free HTTPS certificate from
#                             Let's Encrypt for it and redirects HTTP to HTTPS
{$SITE_ADDRESS::80} {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
