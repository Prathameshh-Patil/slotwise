# Copy this file to .env and fill in real values. .env is git-ignored.
# Every variable the project uses is listed here with a comment.
# The values below are for local development only; never reuse them in production.

# Where the app runs: development, test or production
ENVIRONMENT=development

# PostgreSQL credentials. The db container creates this user and database on first start.
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=slotwise
POSTGRES_DB=slotwise

# How the API connects to PostgreSQL. Docker Compose overrides this to point at the "db"
# container; this value is used when running the API directly on your machine.
DATABASE_URL=postgresql+psycopg://slotwise:slotwise@localhost:5433/slotwise

# Signs login tokens (JWTs). Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-dev-only-change-me-0123456789

# Redis: the queue between the API and the Celery worker. Compose overrides the host.
REDIS_URL=redis://localhost:6379/0

# How many minutes a held seat stays reserved before it is released
HOLD_MINUTES=10

# ---- Optional: the defaults below are used when these stay commented out ----

# How long a login token lasts, in minutes
# ACCESS_TOKEN_MINUTES=60

# Browser origins allowed to call the API, as a JSON list
# CORS_ORIGINS='["http://localhost:3100", "http://localhost:3000"]'

# Run Celery tasks inline instead of through Redis (the tests and the one-container Render image do this)
# CELERY_TASK_ALWAYS_EAGER=false

# Passwords for the seeded admin@slotwise.dev and demo@slotwise.dev accounts (python -m app.seed).
# Unset means the development defaults admin12345 / demo12345: set real ones anywhere public.
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# Front end only: where the browser reaches the API. docker-compose.yml sets it to http://localhost:8000.
# NEXT_PUBLIC_API_URL=http://localhost:8000
