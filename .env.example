# Copy this file to .env and fill in real values. .env is git-ignored.
# Every variable the project uses is listed here with a comment.
# The values below are for local development only; never reuse them in production.

# Where the app runs: development, test or production
ENVIRONMENT=development

# PostgreSQL credentials. The db container creates this user and database on first start.
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=slotwise
POSTGRES_DB=slotwise

# How the API connects to PostgreSQL. Docker Compose overrides this to point at the "db"
# container; this value is used when running the API directly on your machine.
DATABASE_URL=postgresql+psycopg://slotwise:slotwise@localhost:5433/slotwise
